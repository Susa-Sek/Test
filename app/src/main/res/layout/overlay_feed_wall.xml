<?xml version="1.0" encoding="utf-8"?>
<!--
  Die Wand über dem „Für dich“-Feed. Deckend genug, dass nichts mehr zum Weiterwischen
  einlädt, aber ohne Knopf: Der Ausweg steht oben in Instagram, nicht hier.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wall_scrim"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/wall_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/wall_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wall_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/wall_text_muted"
        android:textSize="15sp" />

</LinearLayout>
