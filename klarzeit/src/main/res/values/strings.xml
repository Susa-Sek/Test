<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Klarzeit</string>
    <string name="widget_description">Today\'s screen time without the apps that do not count.</string>

    <!-- Permission -->
    <string name="permission_title">Klarzeit needs usage access</string>
    <string name="permission_body">Android only hands out screen time to apps you allow by hand. The switch sits in Settings under “Special app access → Usage access”.</string>
    <string name="permission_note">Klarzeit has no internet permission. The numbers are worked out on your phone and stay there — there is nobody to send them to.</string>
    <string name="permission_open">Open settings</string>
    <string name="permission_recheck">I have allowed it</string>

    <!-- Home -->
    <string name="home_net_label">Counted today</string>
    <string name="home_goal">Goal %1$s</string>
    <string name="home_goal_over">%1$s over your goal</string>
    <string name="home_goal_left">%1$s left today</string>
    <string name="home_section_counted">Counts</string>
    <string name="home_section_excluded">Does not count</string>
    <string name="home_hint_tap">Tap an app to move it between the two.</string>
    <string name="home_empty">Nothing recorded yet today.</string>
    <string name="home_edit_excluded">Choose which apps count</string>

    <!-- Exclusions -->
    <string name="exclusions_title">What does not count</string>
    <string name="exclusions_hint">Apps with a checkmark stay out of the total. Navigation, music and alarm clocks run for a long time without anyone staring at the screen.</string>
    <string name="exclusions_search">Search apps</string>
    <string name="exclusions_used_today">Used today</string>
    <string name="exclusions_all">All apps</string>

    <!-- Goal -->
    <string name="goal_hint">Klarzeit blocks nothing. It says something once when you go over — and then keeps quiet for the rest of the day.</string>
    <string name="goal_off">No daily goal — tap to set one</string>
    <string name="goal_dialog_title">Daily goal</string>
    <string name="goal_notification_title">Daily goal reached</string>
    <string name="goal_notification_body">%1$s counted today — your goal was %2$s.</string>
    <string name="goal_channel_name">Daily goal</string>
    <string name="goal_channel_description">One message on the day you go over your goal.</string>

    <!-- Widget -->
    <string name="widget_total_short">of %1$s</string>
    <string name="widget_no_permission">Tap to allow usage access</string>
    <string name="widget_refresh">Refresh</string>

